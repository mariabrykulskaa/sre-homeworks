# Скопируйте в .env и подставьте свои значения (III фактор — конфигурация в окружении).
# .env используется только для локальной разработки и не попадает в репозиторий и образ.

# Строка подключения к PostgreSQL (для запуска без Docker)
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow

# Порт HTTP-сервера (VII фактор — привязка портов)
PORT=3000

# Адрес, который слушает сервер. По умолчанию 127.0.0.1 (API без аутентификации
# не должен быть виден локальной сети); в контейнере — 0.0.0.0.
# HOST=127.0.0.1

# Лимит запросов к /api с одного IP в минуту
# RATE_LIMIT_PER_MINUTE=600

# Окружение: попадает в логи как deployment.environment
APP_ENV=development

# Логи (XI фактор): одна строка JSON на событие в stdout.
# LOG_LEVEL=info            # debug | info | warn | error
# SERVICE_NAME=taskflow     # поле service.name

# Метрики (OpenMetrics): GET /metrics на отдельном порту
# METRICS_PORT=9464

# Имя реплики — в заголовок X-Served-By и /api/version (по умолчанию — имя хоста).
# В Kubernetes подставляется из Downward API (metadata.name пода).
# POD_NAME=
# Версию задаёт сборка образа (docker build --build-arg APP_VERSION=…), не конфигурация.

# Внесение сбоев для демонстрации SLO и алертов (по умолчанию выключено, см. taskflow/faults.py)
# FAULT_ERROR_RATE=0        # доля запросов к БД, падающих с ошибкой (0…1)
# FAULT_LATENCY_MS=0        # задержка перед каждым запросом к БД (0…30000 мс)
# FAULT_MEMORY_MB=0         # «утечка памяти»: балласт при старте (0…1024 МБ)

# Переменные для docker compose (имеют локальные dev-дефолты, см. docker-compose.yml)
# POSTGRES_USER=taskflow
# POSTGRES_PASSWORD=taskflow
# POSTGRES_DB=taskflow
