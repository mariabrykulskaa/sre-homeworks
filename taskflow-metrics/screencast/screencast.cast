[0.095, "o", "\r\n=== Бизнес-метрики TaskFlow (сумма по репликам)\r\n▸ sum(taskflow_projects_created_total)\r\n"]
[0.096, "o", "  {}  12\r\n"]
[0.003, "o", "▸ sum(taskflow_projects_deleted_total)\r\n"]
[0.030, "o", "  {}  4\r\n"]
[0.002, "o", "▸ sum by (status) (taskflow_tasks_created_total)\r\n"]
[0.028, "o", "  {status=done}  0\r\n  {status=in_progress}  12\r\n  {status=todo}  36\r\n"]
[0.002, "o", "▸ sum by (from, to) (taskflow_task_status_transitions_total) > 0\r\n"]
[0.030, "o", "  {from=done, to=todo}  4\r\n  {from=in_progress, to=done}  16\r\n  {from=todo, to=done}  12\r\n  {from=todo, to=in_progress}  24\r\n"]
[0.002, "o", "▸ sum(taskflow_task_lead_time_seconds_count)\r\n"]
[0.028, "o", "  {}  28\r\n"]
[0.002, "o", "▸ sum(taskflow_task_lead_time_seconds_sum) / sum(taskflow_task_lead_time_seconds_count)\r\n"]
[0.033, "o", "  {}  0.2113\r\n"]
[0.003, "o", "▸ sum by (status) (taskflow_tasks_deleted_total)\r\n"]
[0.027, "o", "  {status=done}  12\r\n  {status=in_progress}  0\r\n  {status=todo}  0\r\n"]
