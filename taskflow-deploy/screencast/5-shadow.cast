[0.135, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.1.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"host\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"taskflow.local\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"method\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"GET\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"/api/projects\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m200\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"request_id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"269be0fa-94dc-4c58-bb0d-0266a2914c02\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.066, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"host\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"taskflow.local\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"method\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"GET\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"/api/projects\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m200\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"request_id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"269be0fa-94dc-4c58-bb0d-0266a2914c02\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[1.210, "o", "\u001b[2m  Один request_id в обеих версиях: оригинал и его копия (Envoy Gateway не меняет Host копии — disable_shadow_host_suffix_append).\u001b[0m\r\n"]
