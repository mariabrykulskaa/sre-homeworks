[1.205, "o", "\u001b[2m  Другое значение заголовка (staff) — не beta: вариант A.\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[1m\u001b[36m# Две аудитории одновременно, по 10 запросов/с: «все» и «beta»\u001b[0m\r\n"]
[0.607, "o", "\u001b[32m$ scripts/traffic.sh --duration 12 --rps 10 --label 'все ' &\u001b[0m\r\n"]
[0.000, "o", "\u001b[32m$ scripts/traffic.sh --duration 12 --rps 10 --label 'beta' -H 'X-User-Group: beta' &\u001b[0m\r\n"]
