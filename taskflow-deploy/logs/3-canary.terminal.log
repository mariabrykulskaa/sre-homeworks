# Access-лог Envoy: сколько запросов обслужила каждая версия на каждом шаге
$ kubectl -n envoy-gateway-system logs -l gateway.envoyproxy.io/owning-gateway-namespace=taskflow-deploy,gateway.envoyproxy.io/owning-gateway-name=eg -c envoy --tail=-1 --since-time=2026-11-21T14:25:34Z | grep "^{" | jq -r --arg s2 2026-11-21T14:26:28.000Z --arg s3 2026-11-21T14:26:57.000Z 'select(.authority=="taskflow.local") | (if .start_time < $s2 then "шаг 1 (90/10) " elif .start_time < $s3 then "шаг 2 (50/50) " else "шаг 3 (0/100) " end) + .app_version + " " + (.response_code|tostring)' | sort | uniq -c
