
# Canary: stable (2.1.0) и canary (2.2.0) рядом; долю canary задаёт weight в HTTPRoute
$ kubectl apply -k k8s/strategies/canary
service/taskflow-canary created
service/taskflow-stable created
deployment.apps/taskflow-canary created
deployment.apps/taskflow-stable created
httproute.gateway.networking.k8s.io/taskflow created
$ kubectl -n taskflow-deploy get pods -l strategy=canary -o custom-columns=POD:.metadata.name,TRACK:.metadata.labels.track,IMAGE:.spec.containers[0].image,READY:.status.containerStatuses[0].ready,STATUS:.status.phase
