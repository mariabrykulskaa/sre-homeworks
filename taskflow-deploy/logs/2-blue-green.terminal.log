
# Blue/Green: blue (2.1.0) и green (2.2.0) работают рядом, пользователи — на blue
$ kubectl apply -k k8s/strategies/blue-green
service/taskflow-blue created
service/taskflow-green created
deployment.apps/taskflow-blue created
deployment.apps/taskflow-green created
httproute.gateway.networking.k8s.io/taskflow created
httproute.gateway.networking.k8s.io/taskflow-preview created
$ kubectl -n taskflow-deploy get pods -l strategy=blue-green -o custom-columns=POD:.metadata.name,TRACK:.metadata.labels.track,IMAGE:.spec.containers[0].image,READY:.status.containerStatuses[0].ready,STATUS:.status.phase
POD                               TRACK   IMAGE            READY   STATUS
taskflow-blue-75fcc88fcc-5twfz    blue    taskflow:2.1.0   true    Running
taskflow-blue-75fcc88fcc-tsbt7    blue    taskflow:2.1.0   true    Running
taskflow-green-546ff59c9c-q7r24   green   taskflow:2.2.0   true    Running
taskflow-green-546ff59c9c-wldz7   green   taskflow:2.2.0   true    Running
$ kubectl -n taskflow-deploy get httproute -o custom-columns=ROUTE:.metadata.name,HOSTNAMES:.spec.hostnames,BACKENDS:.spec.rules[*].backendRefs[*].name,WEIGHTS:.spec.rules[*].backendRefs[*].weight
ROUTE              HOSTNAMES                  BACKENDS         WEIGHTS
taskflow           [taskflow.local]           taskflow-blue    1
taskflow-preview   [preview.taskflow.local]   taskflow-green   1

# Пользовательский адрес — blue; green проверяем через тот же шлюз по имени preview.taskflow.local
$ curl -s -H 'Host: taskflow.local' http://127.0.0.1:8888/api/version; echo
{"service":"taskflow","version":"2.1.0","instance":"taskflow-blue-75fcc88fcc-tsbt7"}
$ curl -s -H 'Host: preview.taskflow.local' http://127.0.0.1:8888/api/version; echo
{"service":"taskflow","version":"2.2.0","instance":"taskflow-green-546ff59c9c-q7r24"}
$ curl -s -o /dev/null -w 'preview /api/projects → %{http_code}\n' -H 'Host: preview.taskflow.local' http://127.0.0.1:8888/api/projects
preview /api/projects → 200

