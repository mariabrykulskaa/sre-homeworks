# Access-лог Envoy: непрерывные отрезки ответов одной версии (время UTC)
$ kubectl -n envoy-gateway-system logs -l gateway.envoyproxy.io/owning-gateway-namespace=taskflow-deploy,gateway.envoyproxy.io/owning-gateway-name=eg -c envoy --tail=-1 --since-time=2026-11-21T13:48:56Z | grep "^{" | jq -r 'select(.authority=="taskflow.local") | "\(.start_time[11:23]) \(.app_version) \(.response_code)"' | awk '$2!=v {if (v) print v, n, "запросов", t0, "→", t1; v=$2; n=0; t0=$1} {n++; t1=$1} END {print v, n, "запросов", t0, "→", t1}'
