
# Shadow: отвечает primary (2.1.0), копии GET-запросов уходят в shadow (2.2.0)
$ kubectl apply -k k8s/strategies/shadow
service/taskflow-primary created
service/taskflow-shadow created
deployment.apps/taskflow-primary created
deployment.apps/taskflow-shadow created
httproute.gateway.networking.k8s.io/taskflow created
$ kubectl -n taskflow-deploy get pods -l strategy=shadow -o custom-columns=POD:.metadata.name,TRACK:.metadata.labels.track,IMAGE:.spec.containers[0].image,READY:.status.containerStatuses[0].ready,STATUS:.status.phase
POD                                TRACK     IMAGE            READY   STATUS
taskflow-primary-c86b764c7-4tmjv   primary   taskflow:2.1.0   true    Running
taskflow-primary-c86b764c7-xlpnl   primary   taskflow:2.1.0   true    Running
taskflow-shadow-8484f6bd57-2b8ch   shadow    taskflow:2.2.0   true    Running
taskflow-shadow-8484f6bd57-42sg6   shadow    taskflow:2.2.0   true    Running
$ kubectl -n taskflow-deploy get httproute taskflow -o jsonpath='{range .spec.rules[*]}method={.matches[0].method}  filters={.filters[*].requestMirror.backendRef.name}  →  {.backendRefs[0].name}{"\n"}{end}'
method=GET  filters=taskflow-shadow  →  taskflow-primary
method=  filters=  →  taskflow-primary

# 200 GET-запросов: клиенты видят только 2.1.0
$ scripts/traffic.sh --requests 200 --quiet
Итого: 200 запросов за 10.0 с, ошибок 0 (0.00 %)
    2.1.0 ████████████████████████████████████████   200  100.0 %
    2.2.0 ········································     0    0.0 %

# …а shadow получила копии тех же запросов: столько же, с тем же Host
$ kubectl -n taskflow-deploy logs -l track=primary -c taskflow --tail=-1 --since-time=2026-11-21T13:56:21Z | jq -c 'select(.message=="request" and (.path|startswith("/api/")) and (.path|test("health|ready")|not))' | jq -r '"\(."service.version") host=\(.host)"' | sort | uniq -c
 200 2.1.0 host=taskflow.local
$ kubectl -n taskflow-deploy logs -l track=shadow -c taskflow --tail=-1 --since-time=2026-11-21T13:56:21Z | jq -c 'select(.message=="request" and (.path|startswith("/api/")) and (.path|test("health|ready")|not))' | jq -r '"\(."service.version") host=\(.host)"' | sort | uniq -c
 200 2.2.0 host=taskflow.local
$ rid=$(kubectl -n taskflow-deploy logs -l track=shadow -c taskflow --tail=-1 --since-time=2026-11-21T13:56:21Z | jq -c 'select(.message=="request" and (.path|startswith("/api/")) and (.path|test("health|ready")|not))' | jq -r .request_id | tail -1); for t in primary shadow; do kubectl -n taskflow-deploy logs -l track=$t -c taskflow --tail=-1 --since-time=2026-11-21T13:56:21Z | jq -c 'select(.message=="request" and (.path|startswith("/api/")) and (.path|test("health|ready")|not))' | jq -c --arg r "$rid" 'select(.request_id==$r) | {version: ."service.version", host, method, path, status, request_id}'; done
{"version":"2.1.0","host":"taskflow.local","method":"GET","path":"/api/projects","status":200,"request_id":"269be0fa-94dc-4c58-bb0d-0266a2914c02"}
{"version":"2.2.0","host":"taskflow.local","method":"GET","path":"/api/projects","status":200,"request_id":"269be0fa-94dc-4c58-bb0d-0266a2914c02"}
  Один request_id в обеих версиях: оригинал и его копия (Envoy Gateway не меняет Host копии — disable_shadow_host_suffix_append).

# Изменяющие запросы не зеркалируются: копия POST создала бы второй проект в общей базе
$ curl -s -o /dev/null -w 'POST /api/projects → %{http_code}, версия %header{x-app-version}\n' -X POST -H 'Host: taskflow.local' -H 'Content-Type: application/json' -d '{"name":"shadow-demo-135706"}' http://127.0.0.1:8888/api/projects
POST /api/projects → 201, версия 2.1.0
$ for t in primary shadow; do printf '%-8s POST: ' $t; kubectl -n taskflow-deploy logs -l track=$t -c taskflow --tail=-1 --since-time=2026-11-21T13:57:06Z | jq -c 'select(.message=="request" and (.path|startswith("/api/")) and (.path|test("health|ready")|not))' | jq -c 'select(.method=="POST")' | wc -l; done
primary  POST:        1
shadow   POST:        0
$ curl -s -H 'Host: taskflow.local' 'http://127.0.0.1:8888/api/projects?limit=100' | jq '[.data[] | select(.name=="shadow-demo-135706")] | length'
1

