# Скопируйте в .env и подставьте свои значения (III фактор — конфигурация в окружении).
# .env используется только для локальной разработки и не попадает в репозиторий.

# Строка подключения к PostgreSQL (для запуска без Docker)
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow

# Порт HTTP-сервера (VII фактор — привязка портов)
PORT=3000

# Адрес, который слушает сервер. По умолчанию 127.0.0.1 (API без аутентификации
# не должен быть виден локальной сети); в контейнере — 0.0.0.0.
# HOST=127.0.0.1

# Лимит запросов к /api с одного IP в минуту
# RATE_LIMIT_PER_MINUTE=600

NODE_ENV=development

# Логи (XI фактор): одна строка JSON на событие в stdout.
# Порог уровня: debug | info | warn | error (по умолчанию info; регистр не важен)
# LOG_LEVEL=info
# Имя сервиса в поле service.name (по умолчанию — name из package.json)
# SERVICE_NAME=taskflow

# Переменные для docker compose (имеют локальные dev-дефолты, см. docker-compose.yml)
# POSTGRES_USER=taskflow
# POSTGRES_PASSWORD=taskflow
# POSTGRES_DB=taskflow
